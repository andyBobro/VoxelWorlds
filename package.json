{
  "name": "voxelworlds",
  "version": "0.1.0",
  "private": true,
  "description": "Turn map regions into voxel worlds",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prebuild:mac": "node scripts/make-icon.mjs && node scripts/bundle-python.mjs",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.config.cjs",
    "dist:mac": "npm run build:mac",
    "test": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "author": "VoxelWorlds"
}
